generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]
  bookingParticipants BookingParticipant[]
  notifications   Notification[]
  emailVerificationTokens EmailVerificationToken[]
  bookingSeries   BookingSeries[]

  @@index([email])
  @@map("users")
}

model Room {
  id               String    @id @default(uuid()) @db.Uuid
  name             String    @unique
  floor            Int
  capacity         Int
  workStartMinutes Int       @default(540)
  workEndMinutes   Int       @default(1140)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  bookings         Booking[]
  bookingSeries    BookingSeries[]
  notifications    Notification[]

  @@map("rooms")
}

model Booking {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  startAt     DateTime  @db.Timestamptz(3)
  endAt       DateTime  @db.Timestamptz(3)
  roomId      String    @db.Uuid
  userId      String    @db.Uuid
  seriesId    String?   @db.Uuid
  seriesIndex Int?
  isException Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime? @db.Timestamptz(3)
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  series      BookingSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  participants BookingParticipant[]
  notifications Notification[]

  @@index([roomId, startAt])
  @@index([userId, startAt])
  @@index([startAt])
  @@index([cancelledAt])
  @@index([seriesId, startAt])
  @@unique([seriesId, seriesIndex])
  @@map("bookings")
}

model BookingSeries {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  roomId            String    @db.Uuid
  frequency         String    @default("weekly")
  occurrenceCount   Int
  firstStartAt      DateTime  @db.Timestamptz(3)
  durationMinutes   Int
  timezone          String    @default("Europe/Kyiv")
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  cancelledAt       DateTime? @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room              Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookings          Booking[]
  notifications     Notification[]

  @@index([userId, createdAt])
  @@index([roomId, firstStartAt])
  @@map("booking_series")
}

model BookingParticipant {
  bookingId String   @db.Uuid
  userId    String   @db.Uuid
  addedAt   DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([bookingId, userId])
  @@index([userId])
  @@map("booking_participants")
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@index([expire])
  @@map("session")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  bookingId String?   @db.Uuid
  seriesId  String?   @db.Uuid
  roomId    String?   @db.Uuid
  type      String
  title     String
  message   String
  dedupeKey String?   @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  readAt    DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  series    BookingSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  room      Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}
